{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": [
            "ES2020"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "composite": true,
        "baseUrl": ".",
        "paths": {
            "@house-fin/*": [
                "packages/*/"
            ]
        }
    },
    "include": [
        "packages/**/*",
        "apps/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build",
        "**/*.test.ts"
    ]
}